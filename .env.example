# Set to false to call Azure AI Foundry or Azure OpenAI.
DEMO_MODE=false

# Azure AI Foundry project endpoint, for example:
# https://<resource>.services.ai.azure.com/api/projects/<project>
AZURE_AI_PROJECT_ENDPOINT="https://multi-agent-business-asss.services.ai.azure.com/api/projects/Multi-agent-business-ass"
AZURE_AI_MODEL_DEPLOYMENT="gpt-5-mini"

# Optional legacy fallback when a Foundry project endpoint is not used.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21

# Optional: names of agents deployed in your Foundry project.
FOUNDRY_FINANCE_AGENT="finance-analyst"
FOUNDRY_OPERATIONS_AGENT="operations-planner"
FOUNDRY_SALES_AGENT="sales-strategist"
FOUNDRY_RESEARCH_AGENT="market-researcher"
FOUNDRY_BUSINESS_LEAD_AGENT="business-lead"
